{
  "task": "llm",
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "project_name": "qwen-1.5b-nepali-lyrics-autotrain",
  "data_path": "sanbhu/nepali-lyrics-v1",
  "train_split": "train",
  "valid_split": "validation",
  "text_column": "text",
  "lr": 2e-4,
  "epochs": 3,
  "batch_size": 4,
  "max_seq_length": 1024,
  "peft": true,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "quantization": "int4",
  "optimizer": "adamw_torch",
  "scheduler": "cosine",
  "gradient_accumulation": 2,
  "block_size": 1024,
  "logging_steps": 10,
  "evaluation_strategy": "epoch",
  "save_strategy": "epoch",
  "mixed_precision": "fp16"
}
